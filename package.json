{
  "name": "audiobook-studio",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted ebook-to-audiobook studio wrapping a local audio.cpp (Vulkan) TTS server",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n server,web -c blue,green \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch src/index.ts",
    "dev:web": "vite",
    "build": "tsc -p tsconfig.json && vite build",
    "start": "node dist/src/index.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.web.json --noEmit",
    "seed": "tsx scripts/seed.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.3",
    "@fastify/static": "^10.1.11",
    "cheerio": "^1.0.0",
    "fastify": "^5.2.1",
    "fflate": "^0.8.2",
    "nanoid": "^5.1.5",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-router-dom": "^7.5.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.4",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.1.2",
    "tailwindcss": "^4.1.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.1.3"
  }
}
